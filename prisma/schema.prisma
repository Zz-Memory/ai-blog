generator client {
  provider = "prisma-client-js"
}

// 数据源配置：使用 PostgreSQL 作为主数据库，
// `DATABASE_URL` 用于 Prisma Client 的常规连接
datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
}

// 用户角色：区分内容创作者与普通访客。
enum UserRole {
  BLOGGER
  VISITOR
}

// 用户状态：用于软禁用、删除等账号生命周期管理。
enum UserStatus {
  ACTIVE
  DISABLED
  DELETED
}

// 验证码用途：同一张验证码表复用到多个业务场景。
enum VerificationPurpose {
  REGISTER
  RESET_PASSWORD
  BIND_EMAIL
  DELETE_ACCOUNT
}

// 文章发布状态：草稿、已发布、已删除。
enum PostStatus {
  DRAFT
  PUBLISHED
  DELETED
}

// 评论状态：便于审核、屏蔽和软删除。
enum CommentStatus {
  PENDING
  APPROVED
  REJECTED
  DELETED
}

// 通知类型：对应点赞、评论、回复、系统消息等不同来源。
enum NotificationType {
  LIKE
  COMMENT
  REPLY
  SYSTEM
  REVIEW
  NEW_USER
}

// AI 对话模式：支持基于文章上下文和通用闲聊两类会话。
enum AiChatMode {
  POST_CONTEXT
  GENERAL
}

// AI 消息角色：用于记录对话双方身份和提示词消息。
enum AiChatRole {
  USER
  ASSISTANT
  SYSTEM
}

// 用户表：系统核心身份表，关联文章、评论、点赞、收藏、通知等所有用户行为。
model User {
  // 主键，使用 CUID 便于分布式生成。
  id           String     @id @default(cuid())
  // 登录邮箱，唯一。
  email        String     @unique
  // 用户名，展示与检索使用，唯一。
  username     String     @unique
  // 密码哈希，不存明文密码。
  passwordHash String
  // 用户身份角色。
  role         UserRole   @default(VISITOR)
  // 个人简介，可为空。
  intro        String?
  // 当前账号状态。
  status       UserStatus @default(ACTIVE)
  // 创建时间。
  createdAt    DateTime    @default(now())
  // 最后更新时间。
  updatedAt    DateTime    @updatedAt
  // 软删除时间。
  deletedAt    DateTime?

  // 该用户发布的文章。
  posts Post[]
  // 该用户收到/使用过的验证码记录。
  verificationCodes VerificationCode[]
  // 用户登录会话。
  sessions Session[]
  // 用户评论。
  comments Comment[]
  // 用户点赞。
  likes Like[]
  // 用户创建的收藏夹。
  collectionFolders CollectionFolder[]
  // 用户收藏记录。
  bookmarks Bookmark[]
  // 用户浏览历史。
  browseHistories BrowseHistory[]
  // 用户作为发送者发出的通知。
  notificationsSent Notification[] @relation("NotificationSender")
  // 用户作为接收者收到的通知。
  notificationsRecv Notification[] @relation("NotificationRecipient")
  // 用户发起的 AI 会话。
  aiChatSessions AiChatSession[]

  // 按状态建立索引，方便后台筛选活跃/禁用账号。
  @@index([status])
}

// 验证码表：支持注册、重置密码、绑定邮箱、注销等多种场景。
model VerificationCode {
  // 主键。
  id String @id @default(cuid())
  // 目标邮箱。
  email String
  // 验证码内容。
  code String
  // 验证码用途。
  purpose VerificationPurpose
  // 过期时间。
  expiresAt DateTime
  // 使用/消费时间，空值表示未使用。
  consumedAt DateTime?
  // 创建时间。
  createdAt DateTime @default(now())

  // 通过 email 关联到用户邮箱字段。
  user User? @relation(fields: [email], references: [email], onDelete: Cascade)

  // 按邮箱+用途检索验证码。
  @@index([email, purpose])
  // 按过期时间清理过期验证码。
  @@index([expiresAt])
}

// 会话表：用于持久化登录状态，sessionTokenHash 仅保存哈希值。
model Session {
  // 主键。
  id String @id @default(cuid())
  // 所属用户。
  userId String
  // 会话令牌哈希，唯一。
  sessionTokenHash String @unique
  // 过期时间。
  expiresAt DateTime
  // 创建时间。
  createdAt DateTime @default(now())
  // 更新时间。
  updatedAt DateTime @updatedAt

  // 会话所属用户。
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  // 常用查询：按用户查会话。
  @@index([userId])
  // 常用查询：按过期时间清理失效会话。
  @@index([expiresAt])
}

// 文章表：博客核心内容实体。
model Post {
  // 主键。
  id String @id @default(cuid())
  // 作者用户 ID。
  authorId String
  // 标题。
  title String
  // 文章唯一标识，用于 SEO 和路由。
  slug String @unique
  // 摘要，可为空。
  summary String?
  // Markdown 正文。
  contentMarkdown String
  // 渲染后的 HTML 正文，可为空。
  contentHtml String?
  // 发布状态。
  status PostStatus @default(DRAFT)
  // 发布时间，可为空。
  publishedAt DateTime?
  // 创建时间。
  createdAt DateTime @default(now())
  // 更新时间。
  updatedAt DateTime @updatedAt
  // 软删除时间。
  deletedAt DateTime?

  // 作者关系。
  author User @relation(fields: [authorId], references: [id], onDelete: Cascade)
  // 文章评论。
  comments Comment[]
  // 文章点赞。
  likes Like[]
  // 文章收藏记录。
  bookmarks Bookmark[]
  // 文章浏览历史。
  browseHistory BrowseHistory[]
  // 文章标签关联。
  postTags PostTag[]
  // 基于文章上下文的 AI 会话。
  aiChatSessions AiChatSession[]

  // 按作者查询文章。
  @@index([authorId])
  // 按状态/发布时间查询文章列表。
  @@index([status, publishedAt])
}

// 标签表：为文章提供分类与检索能力。
model Tag {
  // 主键。
  id String @id @default(cuid())
  // 标签名称，唯一。
  name String @unique
  // 标签路由/别名，唯一。
  slug String @unique
  // 创建时间。
  createdAt DateTime @default(now())
  // 更新时间。
  updatedAt DateTime @updatedAt
  // 软删除时间。
  deletedAt DateTime?

  // 与文章的多对多关联中间表。
  postTags PostTag[]
}

// 文章标签中间表：显式多对多结构，便于扩展排序、来源等字段。
model PostTag {
  // 文章 ID。
  postId String
  // 标签 ID。
  tagId String
  // 关联创建时间。
  createdAt DateTime @default(now())

  // 关联文章。
  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  // 关联标签。
  tag Tag @relation(fields: [tagId], references: [id], onDelete: Cascade)

  // 复合主键保证一篇文章不会重复绑定同一个标签。
  @@id([postId, tagId])
  // 按标签查文章。
  @@index([tagId])
}

// 评论表：支持楼中楼回复、审核状态和点赞计数。
model Comment {
  // 主键。
  id String @id @default(cuid())
  // 所属文章。
  postId String
  // 评论用户。
  userId String
  // 父评论 ID，空值表示顶级评论。
  parentId String?
  // 评论内容。
  content String
  // 审核状态。
  status CommentStatus @default(PENDING)
  // 评论点赞计数。
  likeCount Int @default(0)
  // 创建时间。
  createdAt DateTime @default(now())
  // 更新时间。
  updatedAt DateTime @updatedAt
  // 软删除时间。
  deletedAt DateTime?

  // 所属文章。
  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  // 评论作者。
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  // 父评论，删除父评论时置空，保留子回复。
  parent Comment? @relation("CommentReplies", fields: [parentId], references: [id], onDelete: SetNull)
  // 子回复列表。
  replies Comment[] @relation("CommentReplies")

  // 按文章查评论。
  @@index([postId])
  // 按用户查评论。
  @@index([userId])
  // 按父评论查回复。
  @@index([parentId])
  // 按审核状态筛选评论。
  @@index([status])
}

// 点赞表：记录用户对文章的点赞行为。
model Like {
  // 主键。
  id String @id @default(cuid())
  // 点赞用户。
  userId String
  // 被点赞文章。
  postId String
  // 点赞时间。
  createdAt DateTime @default(now())

  // 点赞用户。
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  // 点赞文章。
  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)

  // 同一用户不能重复点赞同一篇文章。
  @@unique([userId, postId])
  // 按文章统计点赞。
  @@index([postId])
}

// 收藏夹表：一个用户可以创建多个收藏夹，默认收藏夹可单独标记。
model CollectionFolder {
  // 主键。
  id String @id @default(cuid())
  // 所属用户。
  userId String
  // 收藏夹名称。
  name String
  // 是否为默认收藏夹。
  isDefault Boolean @default(false)
  // 创建时间。
  createdAt DateTime @default(now())
  // 更新时间。
  updatedAt DateTime @updatedAt
  // 软删除时间。
  deletedAt DateTime?

  // 所属用户。
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  // 该收藏夹内的收藏记录。
  bookmarks Bookmark[]

  // 按用户查询收藏夹。
  @@index([userId])
  // 按用户与默认收藏夹状态查询。
  @@index([userId, isDefault])
}

// 收藏记录表：用户收藏某篇文章，可归入指定收藏夹。
model Bookmark {
  // 主键。
  id String @id @default(cuid())
  // 收藏用户。
  userId String
  // 被收藏文章。
  postId String
  // 所属收藏夹，可为空表示未分类。
  folderId String?
  // 创建时间。
  createdAt DateTime @default(now())

  // 收藏用户。
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  // 收藏文章。
  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  // 可选收藏夹。
  folder CollectionFolder? @relation(fields: [folderId], references: [id], onDelete: SetNull)

  // 同一用户不能重复收藏同一篇文章。
  @@unique([userId, postId])
  // 按收藏夹查收藏记录。
  @@index([folderId])
  // 按文章查收藏情况。
  @@index([postId])
}

// 浏览历史表：记录用户访问文章的时间，支持最近浏览列表。
model BrowseHistory {
  // 主键。
  id String @id @default(cuid())
  // 浏览用户。
  userId String
  // 浏览文章。
  postId String
  // 实际访问时间。
  visitedAt DateTime @default(now())
  // 创建时间。
  createdAt DateTime @default(now())

  // 浏览用户。
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  // 浏览文章。
  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)

  // 按用户+时间倒序取最近浏览。
  @@index([userId, visitedAt])
  // 按文章统计访问历史。
  @@index([postId])
}

// 通知表：用于站内消息中心，支持发送者、接收者与跳转链接。
model Notification {
  // 主键。
  id String @id @default(cuid())
  // 接收通知的用户。
  recipientId String
  // 发送者，可为空（如系统通知）。
  senderId String?
  // 通知类型。
  type NotificationType
  // 通知标题。
  title String
  // 通知正文。
  content String
  // 相关跳转链接，可为空。
  linkUrl String?
  // 是否已读。
  isRead Boolean @default(false)
  // 创建时间。
  createdAt DateTime @default(now())
  // 阅读时间。
  readAt DateTime?
  // 软删除时间。
  deletedAt DateTime?

  // 通知接收者。
  recipient User @relation("NotificationRecipient", fields: [recipientId], references: [id], onDelete: Cascade)
  // 通知发送者。
  sender User? @relation("NotificationSender", fields: [senderId], references: [id], onDelete: SetNull)

  // 按接收者和时间获取消息流。
  @@index([recipientId, createdAt])
  // 按发送者检索通知。
  @@index([senderId])
  // 按通知类型筛选。
  @@index([type])
}

// AI 会话表：保存一次对话上下文，可绑定到某篇文章。
model AiChatSession {
  // 主键。
  id String @id @default(cuid())
  // 会话所属用户。
  userId String
  // 关联文章，可为空。
  postId String?
  // 会话模式。
  mode AiChatMode @default(POST_CONTEXT)
  // 会话标题，可选。
  title String?
  // 创建时间。
  createdAt DateTime @default(now())
  // 更新时间。
  updatedAt DateTime @updatedAt
  // 软删除时间。
  deletedAt DateTime?

  // 会话所属用户。
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  // 关联文章，删除文章时会置空。
  post Post? @relation(fields: [postId], references: [id], onDelete: SetNull)
  // 会话消息列表。
  messages AiChatMessage[]

  // 按用户和时间查最近会话。
  @@index([userId, createdAt])
  // 按文章过滤会话。
  @@index([postId])
  // 按模式筛选会话。
  @@index([mode])
}

// AI 会话消息表：保存用户、助手与系统消息。
model AiChatMessage {
  // 主键。
  id String @id @default(cuid())
  // 所属会话。
  sessionId String
  // 消息角色。
  role AiChatRole
  // 消息内容。
  content String
  // 估算 token 数，可为空。
  tokenCount Int?
  // 创建时间。
  createdAt DateTime @default(now())

  // 所属会话。
  session AiChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  // 按会话和时间顺序读取消息。
  @@index([sessionId, createdAt])
}
