generator client {
  provider = "prisma-client-js"
}

// 数据库连接配置，实际连接串通过环境变量注入
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============ 用户与认证相关枚举 ============

enum UserRole {
  BLOGGER
  VISITOR
}

// 用户状态：活跃、禁言
enum UserStatus {
  ACTIVE
  BANNED
}

// 验证码用途：注册、重置密码、注销账号
enum VerificationPurpose {
  REGISTER
  RESET_PASSWORD
  DELETE_ACCOUNT
}

// ============ 内容管理相关枚举 ============

enum PostStatus {
  DRAFT
  PUBLISHED
}

enum CommentStatus {
  PENDING
  APPROVED
}

enum NotificationType {
  COMMENT
  SYSTEM
}

// AI 消息角色：用户、助手
enum AiChatRole {
  USER
  ASSISTANT
}

// ============ 用户表 ============
model User {
  id               String             @id @default(cuid())
  email            String             @unique
  username         String             @unique
  passwordHash     String
  role             UserRole           @default(VISITOR)
  intro            String?
  status           UserStatus         @default(ACTIVE)
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  posts            Post[]
  sessions         Session[]
  comments         Comment[]
  likes            Like[]
  bookmarks        Bookmark[]
  browseHistories  BrowseHistory[]
  notificationsSent Notification[]    @relation("NotificationSender")
  notificationsRecv Notification[]    @relation("NotificationRecipient")
  aiChatSessions   AiChatSession[]

  @@index([status])
}

// ============ 验证码表 ============
model VerificationCode {
  id         String              @id @default(cuid())
  email      String
  code       String
  purpose    VerificationPurpose
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime            @default(now())

  @@index([email, code, purpose])
  @@index([expiresAt])
}

// ============ 会话表 ============
model Session {
  id               String   @id @default(cuid())
  userId           String
  sessionTokenHash String   @unique
  expiresAt        DateTime
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

// ============ 文章表 ============
model Post {
  id              String      @id @default(cuid())
  authorId        String
  categoryId      String?
  title           String
  slug            String      @unique
  summary         String?
  contentMarkdown String
  contentHtml     String?
  status          PostStatus  @default(DRAFT)
  publishedAt     DateTime?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  author          User        @relation(fields: [authorId], references: [id], onDelete: Cascade)
  category        Category?   @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  comments        Comment[]
  likes           Like[]
  bookmarks       Bookmark[]
  browseHistories BrowseHistory[]
  postTags        PostTag[]
  aiChatSessions  AiChatSession[]

  @@index([authorId])
  @@index([categoryId])
  @@index([status, publishedAt])
}

// ============ 分类表 ============
model Category {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  posts       Post[]
}

// ============ 标签表 ============
model Tag {
  id        String   @id @default(cuid())
  name      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  postTags   PostTag[]
}

// ============ 文章标签关联表 ============
model PostTag {
  postId    String
  tagId     String
  createdAt DateTime @default(now())

  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  tag       Tag      @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([postId, tagId])
  @@index([tagId])
}

// ============ 评论表 ============
model Comment {
  id        String        @id @default(cuid())
  postId    String
  userId    String
  parentId  String?
  content   String
  status    CommentStatus @default(PENDING)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  post      Post          @relation(fields: [postId], references: [id], onDelete: Cascade)
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  parent    Comment?      @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies   Comment[]     @relation("CommentReplies")

  @@index([postId])
  @@index([userId])
  @@index([parentId])
  @@index([status])
}

// ============ 点赞表 ============
model Like {
  id      String   @id @default(cuid())
  userId  String
  postId  String
  createdAt DateTime @default(now())

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  post    Post     @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@unique([userId, postId])
  @@index([postId])
}

// ============ 收藏表 ============
model Bookmark {
  id        String   @id @default(cuid())
  userId    String
  postId    String
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@unique([userId, postId])
  @@index([postId])
}

// ============ 浏览历史表 ============
model BrowseHistory {
  id        String   @id @default(cuid())
  userId    String
  postId    String
  visitedAt DateTime @default(now())
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@index([userId, visitedAt])
  @@index([postId])
}

// ============ 通知表 ============
model Notification {
  id          String             @id @default(cuid())
  recipientId String
  senderId    String?
  type        NotificationType
  title       String
  content     String
  linkUrl     String?
  isRead      Boolean            @default(false)
  createdAt   DateTime           @default(now())
  readAt      DateTime?

  recipient   User               @relation("NotificationRecipient", fields: [recipientId], references: [id], onDelete: Cascade)
  sender      User?              @relation("NotificationSender", fields: [senderId], references: [id], onDelete: SetNull)

  @@index([recipientId, createdAt])
  @@index([senderId])
  @@index([type])
}

// ============ AI 问答会话表 ============
model AiChatSession {
  id        String         @id @default(cuid())
  userId    String
  postId    String
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  post      Post           @relation(fields: [postId], references: [id], onDelete: Cascade)
  messages  AiChatMessage[]

  @@index([userId, createdAt])
  @@index([postId])
}

// ============ AI 问答消息表 ============
model AiChatMessage {
  id        String       @id @default(cuid())
  sessionId String
  role      AiChatRole
  content   String
  createdAt DateTime     @default(now())

  session   AiChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId, createdAt])
}
